# KolamCraft Environment Configuration

# Supabase (Optional - fallback to local mock storage if not configured)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# SQLite (Optional - server-side/local API placeholder values)
# SQLite itself uses a file path, not a username/password. Keep credentials
# un-prefixed by VITE_ so they are never exposed to the browser bundle.
DATABASE_URL=file:./database/kolamcraft.sqlite
DATABASE_USER=your_database_user_here
DATABASE_PASSWORD=your_database_password_here
DATABASE_SECRET=your_database_secret_here

# Note: If you leave these blank, the app will run in local-only mode with mock data
